# ============================================================
# Prompt Battle — environment configuration
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.
# ============================================================

# ------------------------------------------------------------
# Supabase  (https://supabase.com → New Project)
# Get these from: Dashboard → Project Settings → API
# Region tip: pick one close to your event for low latency.
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-side key. Either the legacy "anon" key OR the new
# publishable key (sb_publishable_...) works — both are safe to
# expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only key. Either the legacy "service_role" key OR the new
# secret key (sb_secret_...). Used in server actions for privileged
# writes (image/video generation, host controls). NEVER expose to
# the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ------------------------------------------------------------
# AI providers — set a key for at least one.
# These are YOUR keys — you pay for the images/videos generated by
# your tournaments. Models are addressed as "<provider>:<model id>",
# e.g. google:gemini-3-pro-image, openai:gpt-image-2.5-flare,
# replicate:black-forest-labs/flux-2-pro. In hosted mode, only the
# providers configured here appear in the paid plan's model picker;
# hosts with their own keys (BYO) can use any provider/model.
# ------------------------------------------------------------
# Google — Nano Banana + Gemini Omni  (https://aistudio.google.com/apikey)
# The default models (free + premium) run on Google.
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# OpenAI — GPT Image, images only  (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...

# Replicate — FLUX, Kling, Seedance, Veo, … (https://replicate.com/account/api-tokens)
# REPLICATE_API_TOKEN=r8_...

# --- Default image model (optional — sensible default if unset) -----
# Which model generates result images for paid tournaments that haven't
# picked one. Bare ids are Google models; use a full ref (e.g.
# openai:gpt-image-2.5-flare) for other providers. Retired ids are
# mapped to their successors automatically.
#   gemini-3-pro-image           → "Nano Banana Pro", best quality,
#                                   ~$0.134 / 1K image             (DEFAULT)
#   gemini-nano-banana-2.1       → Google's workhorse, ~$0.034 / 1K image
#                                   (the free plan's model)
#   gemini-3.1-flash-lite-image  → fastest & cheapest, ~$0.034, 1K only
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Output resolution for Google image models: 1K | 2K | 4K.
# Bigger = sharper but pricier. 1K is plenty for a projector reveal.
# GEMINI_IMAGE_SIZE=1K

# --- Default video model (optional — only used by video tasks) ------
#   gemini-omni-1.1-flash        → Gemini Omni Flash, ~$0.10/sec at
#                                   720p                           (DEFAULT)
# (Veo 3.x preview models shut down on 2026-10-22; OpenAI retired Sora.)
# Video tasks are the expensive option (~$1.60–2.00 per match for two
# clips). If you only want image tasks, you can ignore this.
# VEO_MODEL=gemini-omni-1.1-flash

# ------------------------------------------------------------
# Host authentication
# Single shared password for the tournament host (the /admin area).
# Choose something strong — anyone with this can run/delete tournaments.
# (Hosted multi-tenant mode on the phase-2 branch uses Supabase Auth
# instead; this password only applies to the single-host setup.)
# ------------------------------------------------------------
HOST_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------
# Free-tier caps (hosted mode only — phase-2 branch)
# How many free-plan tournaments one account may START per rolling
# 30 days. The global platform spend cap lives in the DB
# (platform_usage.hard_cap_cents, default 5000 = ~USD 50).
# ------------------------------------------------------------
# FREE_GAMES_PER_MONTH=5

# ------------------------------------------------------------
# Stripe pay-per-event (hosted mode only — phase-2 branch)
# Secret key: Stripe Dashboard → Developers → API keys. Use the
# sk_test_... key while testing, sk_live_... in production.
# Payment methods come from the Dashboard's "Payment methods" page:
# cards (Visa/Mastercard) are on by default; enable TWINT there for
# the Swiss market — no code change needed.
# ------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...

# Optional but recommended: webhook signing secret so payments are
# fulfilled even when the payer never returns to the app.
# Dashboard → Developers → Webhooks → Add endpoint:
#   https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
# STRIPE_WEBHOOK_SECRET=whsec_...

# Price of one premium upgrade, in minor units of PREMIUM_CURRENCY.
# Defaults: 900 rappen = CHF 9.00.
# PREMIUM_PRICE_CENTS=900
# PREMIUM_CURRENCY=chf

# ------------------------------------------------------------
# BYO-key encryption (hosted mode only — phase-2 branch)
# Hosts can store their own Google / OpenAI / Replicate keys per
# tournament (premium features + any model, at zero platform cost). Keys are AES-256-GCM encrypted
# with this 32-byte data key before hitting the database. Generate:
#   openssl rand -base64 32
# Rotating it invalidates stored keys (hosts simply re-enter them).
# Without it, the BYO-key card is hidden.
# ------------------------------------------------------------
# SECRETS_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Paid-plan cost ceiling (hosted mode only — phase-2 branch)
# The most generation one flat-price premium tournament may cost the
# platform, in US cents. Checked before start (never mid-game): a
# bracket whose worst-case estimate exceeds it can't start — the host
# trims video tasks, picks a cheaper model, or brings their own key.
# Default 800 = US$8 (keeps a CHF 9 event profitable).
# ------------------------------------------------------------
# PREMIUM_MAX_COST_CENTS=800

# ------------------------------------------------------------
# Public site identity (hosted mode)
# Canonical URL used for SEO metadata, the sitemap and social cards.
# ------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://promptbattle.io

# Operator details shown on /legal/imprint, /legal/privacy and
# /legal/terms. Required by Swiss/EU law for a commercial site.
# Placeholders are shown until these are set.
# LEGAL_NAME=Jane Doe
# LEGAL_ADDRESS=Examplestrasse 1, 8000 Zürich, Switzerland
# LEGAL_EMAIL=hello@example.com

# ------------------------------------------------------------
# Host feedback (hosted mode)
# The "Feedback" button in the host area stores each message in the
# `feedback` table (migration 0017) and emails it via Resend.
# RESEND_API_KEY: Resend → API Keys (sending access). Without it,
# feedback is still saved, just not emailed.
# FEEDBACK_EMAIL: where feedback goes (default hello@promptbattle.io).
# ------------------------------------------------------------
# RESEND_API_KEY=re_...
# FEEDBACK_EMAIL=hello@promptbattle.io
